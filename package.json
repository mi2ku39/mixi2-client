{
  "name": "@mi2ku39/mixi2-client",
  "type": "module",
  "version": "0.0.0-beta.0",
  "description": "TypeScript client types and RPC utilities for the mixi2 API.",
  "author": "mi2ku39 <author.name@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/mi2ku39/mixi2-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mi2ku39/mixi2-client.git"
  },
  "bugs": {
    "url": "https://github.com/mi2ku39/mixi2-client/issues"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "version:bump": "bumpp --no-commit --no-tag",
    "prepublishOnly": "pnpm run build",
    "generate:mixi2-grpc": "node --experimental-strip-types scripts/generate-mixi2-api-grpc.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.1",
    "@bufbuild/protobuf": "^2.11.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.59.0",
    "@types/node": "^25.0.3",
    "bumpp": "^10.3.2",
    "grpc-tools": "^1.13.0",
    "ts-proto": "^2.8.3",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
