{
  "name": "@mi2ku39/mixi2-client",
  "type": "module",
  "version": "0.0.0-beta.1",
  "description": "TypeScript client types and RPC utilities for the mixi2 API.",
  "author": "Author Name <author.name@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/mi2ku39/mixi2-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mi2ku39/mixi2-ts.git"
  },
  "bugs": {
    "url": "https://github.com/mi2ku39/mixi2-ts/issues"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "version:bump": "bumpp --no-commit --no-tag",
    "prepublishOnly": "pnpm run build",
    "generate:mixi2-types": "tsx scripts/generate-mixi2-api-types.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.59.0",
    "@bufbuild/protobuf": "^2.11.0",
    "@types/node": "^25.0.3",
    "bumpp": "^10.3.2",
    "openapi-typescript": "^7.10.1",
    "tsdown": "^0.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
